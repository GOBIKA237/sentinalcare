# --- Server ---
PORT=4000
NODE_ENV=development

# --- Postgres ---
PGHOST=postgres
PGPORT=5432
PGUSER=sentinelcare
PGPASSWORD=changeme_use_a_strong_password
PGDATABASE=sentinelcare

# --- JWT ---
JWT_ACCESS_SECRET=replace_with_openssl_rand_hex_32
JWT_REFRESH_SECRET=replace_with_a_different_openssl_rand_hex_32
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# --- Field-level encryption for check-in notes (AES-256-GCM) ---
# Must be a 32-byte key, base64-encoded. Generate with:
#   openssl rand -base64 32
CHECKIN_ENCRYPTION_KEY=replace_with_base64_32_byte_key

# --- Rate limiting (gateway layer) ---
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100
